rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Shared helper functions ──────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    // ── School Management App (SMS) ──────────────────────────────────────────

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/sms-users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/sms-users/$(request.auth.uid)).data.role == 'admin';
    }
    function isTeacher() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/sms-users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/sms-users/$(request.auth.uid)).data.role == 'teacher';
    }
    function isAdminOrTeacher() { return isAdmin() || isTeacher(); }

    // ── Lifeline App ─────────────────────────────────────────────────────────

    function isLifelineAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/lifeline_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/lifeline_users/$(request.auth.uid)).data.role == 'admin';
    }
    function isLifelineDriver() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/lifeline_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/lifeline_users/$(request.auth.uid)).data.role == 'driver';
    }
    function isLifelineDispatcher() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/lifeline_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/lifeline_users/$(request.auth.uid)).data.role == 'dispatcher';
    }
    function isLifelineStaff() {
      return isLifelineAdmin() || isLifelineDriver() || isLifelineDispatcher();
    }

    // ── Asthma App ───────────────────────────────────────────────────────────

    function isAsthmaProvider() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/asthma_app_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/asthma_app_users/$(request.auth.uid)).data.role == 'provider';
    }

    // ── Digital Timetable App ────────────────────────────────────────────────

    function isDigitableAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/digital_time_table_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/digital_time_table_users/$(request.auth.uid)).data.role == 'admin';
    }

    // ════════════════════════════════════════════════════════════════════════
    // ASTHMA APP
    // ════════════════════════════════════════════════════════════════════════

    match /asthma_app_users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if isAuthenticated() && request.auth.uid == userId;
    }
    match /asthma_app_medications/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAsthmaProvider());
    }
    match /asthma_app_symptom_logs/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }
    match /asthma_app_emergencies/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (resource.data.patientId == request.auth.uid || isAsthmaProvider());
      allow delete: if isAsthmaProvider();
    }

    // ════════════════════════════════════════════════════════════════════════
    // LIFELINE APP
    // ════════════════════════════════════════════════════════════════════════

    match /lifeline_users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isLifelineAdmin());
      allow delete: if isLifelineAdmin();
    }
    match /lifeline_emergencies/{emergencyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isLifelineStaff());
      allow delete: if isLifelineAdmin();
    }
    match /lifeline_ambulances/{ambulanceId} {
      allow read: if isAuthenticated();
      allow create, update: if isLifelineStaff();
      allow delete: if isLifelineAdmin();
    }
    match /lifeline_drivers/{driverId} {
      allow read: if isAuthenticated();
      allow create: if isLifelineAdmin();
      allow update: if isAuthenticated() && (request.auth.uid == driverId || isLifelineAdmin());
      allow delete: if isLifelineAdmin();
    }
    match /lifeline_tracking/{trackingId} {
      allow read: if isAuthenticated();
      allow create, update: if isLifelineStaff();
      allow delete: if isLifelineAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // VETERINARY / FARMING APP
    // ════════════════════════════════════════════════════════════════════════

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if isAuthenticated() &&
        (request.auth.uid == userId ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    match /disease_reports/{reportId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    match /conversations/{conversationId} {
      allow read, create, update, delete: if isAuthenticated();
      match /messages/{messageId} {
        allow read, create, update, delete: if isAuthenticated();
      }
    }

    // ════════════════════════════════════════════════════════════════════════
    // SCHOOL MANAGEMENT APP (SMS)
    // ════════════════════════════════════════════════════════════════════════

    match /sms-users/{userId} {
      allow read: if isAuthenticated();
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId || isAdmin();
      allow delete: if isAdmin();
    }
    match /sms-students/{studentId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdminOrTeacher();
      allow delete: if isAdmin();
    }
    match /sms-teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /sms-attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrTeacher();
    }
    match /sms-grades/{gradeId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrTeacher();
    }
    match /sms-fees/{feeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /sms-fee-payments/{paymentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // SAFEMAMA APP
    // ════════════════════════════════════════════════════════════════════════

    match /safemama/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      match /bp_readings/{readingId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
      match /risk_assessments/{assessmentId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
      match /patients/{patientId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }
    match /safemama/shared/health_tips/{tipId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ════════════════════════════════════════════════════════════════════════
    // MAMAPULSE APP
    // ════════════════════════════════════════════════════════════════════════

    match /mama_pulse_users/{userId} {
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }
    match /mama_pulse_health_records/{recordId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update, delete: if false;
    }
    match /mama_pulse_anc_visits/{visitId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // ════════════════════════════════════════════════════════════════════════
    // DIGITAL TIMETABLE APP
    // ════════════════════════════════════════════════════════════════════════

    match /digital_time_table_users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isDigitableAdmin());
      allow delete: if isDigitableAdmin();
    }
    match /digital_time_table_entries/{entryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isDigitableAdmin();
    }
    match /digital_time_table_subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isDigitableAdmin();
    }
    match /digital_time_table_teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isDigitableAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // AGRO LOANS (legacy — kept for migration reads)
    // These are READ-ONLY now. The migration service copies data to saccoplus-*
    // and new writes go to saccoplus-* only.
    // ════════════════════════════════════════════════════════════════════════

    match /agro-loans-users/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    match /agro-loans-loans/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    match /agro-loans-repayments/{docId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    match /agro-loans-notifications/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /agro-loans-wallets/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /agro-loans-wallet-transactions/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /agro-loans-airtime-transactions/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // ════════════════════════════════════════════════════════════════════════
    // SACCOPLUS PRO — all new collections
    // Phone+PIN auth means no Firebase Auth UID on most requests.
    // Rules use `if true` for member-facing collections (same pattern as the
    // original agro-loans rules). Admin-only collections are locked down.
    //
    // MULTI-TENANT NOTE:
    // Tenant isolation is enforced at the application layer:
    //   - sessionTenantId is injected into every Firestore query
    //   - every write includes a tenantId field
    //   - admin queries filter by tenantId before returning results
    //
    // The Firestore rules below allow read/write for authenticated app
    // sessions. Full server-side tenant enforcement requires Firebase Auth
    // with custom claims — a future enhancement once Phone+PIN auth is
    // migrated to Firebase Auth tokens.
    // ════════════════════════════════════════════════════════════════════════

    // ── Members (users) ──────────────────────────────────────────────────────
    // Open read/write: phone+PIN login has no Firebase Auth session.
    // Security is enforced at the app layer (PIN hash verification).
    match /saccoplus-members/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // ── Loans ────────────────────────────────────────────────────────────────
    match /saccoplus-loans/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // ── Repayments ───────────────────────────────────────────────────────────
    match /saccoplus-repayments/{docId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // ── Guarantors ───────────────────────────────────────────────────────────
    match /saccoplus-guarantors/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // ── Savings ──────────────────────────────────────────────────────────────
    match /saccoplus-savings/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /saccoplus-savings-transactions/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // ── Fixed Deposits ───────────────────────────────────────────────────────
    match /saccoplus-fixed-deposits/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // ── Shares ───────────────────────────────────────────────────────────────
    match /saccoplus-shares/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
      match /transactions/{txnId} {
        allow read, create: if true;
        allow update, delete: if false;
      }
    }
    match /saccoplus-dividends/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // ── Wallets ──────────────────────────────────────────────────────────────
    match /saccoplus-wallets/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /saccoplus-wallet-transactions/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /saccoplus-airtime-transactions/{docId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // ── Notifications ────────────────────────────────────────────────────────
    match /saccoplus-notifications/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // ── Audit Logs (append-only, no deletes or updates) ──────────────────────
    match /saccoplus-audit-logs/{docId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // ── Accounting / General Ledger ───────────────────────────────────────────
    match /saccoplus-ledger/{docId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    match /saccoplus-accounts/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // ── SACCO config & branches ───────────────────────────────────────────────
    match /saccoplus-saccos/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    match /saccoplus-branches/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // ── Staff & Roles (RBAC) ──────────────────────────────────────────────────
    match /saccoplus-staff/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /saccoplus-roles/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // ── Till Management (append-only cash ledger) ──────────────────────────────
    // Till sessions: can create and read; updates allowed only for specific fields
    match /saccoplus-till-sessions/{docId} {
      allow read, create: if true;
      allow update: if true;  // Status changes, close operations, variance approval
      allow delete: if false;  // Never allow session deletion
    }
    
    // Till entries: strictly append-only (no updates or deletes ever)
    match /saccoplus-till-entries/{docId} {
      allow read, create: if true;
      allow update, delete: if false;  // APPEND-ONLY: corrections via reversing entries
    }

    // ── Teller Transactions ───────────────────────────────────────────────────
    match /saccoplus-teller-transactions/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // ── Migration sentinel ────────────────────────────────────────────────────
    match /saccoplus-meta/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // ── Login Attempts (for rate limiting and security) ───────────────────────
    match /login_attempts/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // ── OTP Storage (for web OTP verification) ─────────────────────────────────
    match /otps/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // ════════════════════════════════════════════════════════════════════════
    // DENY EVERYTHING ELSE
    // ════════════════════════════════════════════════════════════════════════

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
