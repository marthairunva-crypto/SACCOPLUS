import 'package:flutter/material.dart';
import 'package:google_fonts/google_fonts.dart';
import 'package:intl/intl.dart';
import '../../core/theme.dart';
import '../../core/constants.dart';
import '../../core/firebase_service.dart';
import '../../widgets/app_widgets.dart';
import '../auth/login_screen.dart';
import 'apply_loan_screen.dart';
import 'loan_status_screen.dart';
import 'repayment_screen.dart';
import 'profile_screen.dart';
import 'notifications_screen.dart';

class FarmerDashboard extends StatefulWidget {
  const FarmerDashboard({super.key});

  @override
  State<FarmerDashboard> createState() => _FarmerDashboardState();
}

class _FarmerDashboardState extends State<FarmerDashboard> {
  int _selectedIndex = 0;
  Map<String, dynamic>? _profile;

  // Demo stats
  final Map<String, dynamic> _demoStats = {
    'activeLoans': 1,
    'totalBorrowed': 2500000,
    'totalPaid': 1200000,
    'pendingLoans': 1,
  };

  @override
  void initState() {
    super.initState();
    _loadProfile();
  }

  Future<void> _loadProfile() async {
    try {
      final uid = FirebaseService.currentUser?.uid;
      if (uid != null) {
        final p = await FirebaseService.getUserProfile(uid);
        if (mounted) setState(() => _profile = p);
      }
    } catch (_) {}
  }

  String get _greeting {
    final h = DateTime.now().hour;
    if (h < 12) return 'Good Morning';
    if (h < 17) return 'Good Afternoon';
    return 'Good Evening';
  }

  String get _farmerName =>
      _profile?['name'] ?? 'Farmer';

  @override
  Widget build(BuildContext context) {
    final pages = [
      _HomeTab(
        greeting: _greeting,
        name: _farmerName,
        stats: _demoStats,
        onApply: () => _go(const ApplyLoanScreen()),
        onStatus: () => _go(const LoanStatusScreen()),
        onRepay: () => _go(const RepaymentScreen()),
        onNotif: () => _go(const NotificationsScreen()),
      ),
      const LoanStatusScreen(embedded: true),
      const RepaymentScreen(embedded: true),
      ProfileScreen(profile: _profile),
    ];

    return Scaffold(
      backgroundColor: AppTheme.surface,
      body: pages[_selectedIndex],
      bottomNavigationBar: _BottomNav(
        selectedIndex: _selectedIndex,
        onTap: (i) => setState(() => _selectedIndex = i),
      ),
    );
  }

  void _go(Widget page) {
    Navigator.push(context, MaterialPageRoute(builder: (_) => page));
  }
}

// â”€â”€â”€ Home Tab â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
class _HomeTab extends StatelessWidget {
  final String greeting;
  final String name;
  final Map<String, dynamic> stats;
  final VoidCallback onApply;
  final VoidCallback onStatus;
  final VoidCallback onRepay;
  final VoidCallback onNotif;

  const _HomeTab({
    required this.greeting,
    required this.name,
    required this.stats,
    required this.onApply,
    required this.onStatus,
    required this.onRepay,
    required this.onNotif,
  });

  @override
  Widget build(BuildContext context) {
    final fmt = NumberFormat('#,###', 'en_US');
    return CustomScrollView(
      slivers: [
        // App bar with gradient
        SliverAppBar(
          expandedHeight: 180,
          pinned: true,
          backgroundColor: AppTheme.primary,
          automaticallyImplyLeading: false,
          actions: [
            IconButton(
              icon: const Icon(Icons.notifications_outlined, color: Colors.white),
              onPressed: onNotif,
            ),
            IconButton(
              icon: const Icon(Icons.logout_rounded, color: Colors.white),
              onPressed: () => _confirmLogout(context),
            ),
          ],
          flexibleSpace: FlexibleSpaceBar(
            background: Container(
              decoration: const BoxDecoration(
                gradient: LinearGradient(
                  colors: [AppTheme.primaryDark, AppTheme.primaryLight],
                  begin: Alignment.topLeft,
                  end: Alignment.bottomRight,
                ),
              ),
              padding: const EdgeInsets.fromLTRB(20, 80, 20, 16),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                mainAxisAlignment: MainAxisAlignment.end,
                children: [
                  Text(
                    '$greeting, $name ðŸ‘‹',
                    style: GoogleFonts.poppins(
                      color: Colors.white,
                      fontSize: 20,
                      fontWeight: FontWeight.w600,
                    ),
                  ),
                  Text(
                    AppConstants.appSubtitle,
                    style: GoogleFonts.poppins(
                        color: Colors.white70, fontSize: 12),
                  ),
                ],
              ),
            ),
          ),
        ),

        SliverToBoxAdapter(
          child: Padding(
            padding: const EdgeInsets.all(16),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                // Balance card
                Container(
                  width: double.infinity,
                  padding: const EdgeInsets.all(20),
                  decoration: BoxDecoration(
                    gradient: const LinearGradient(
                      colors: [AppTheme.primary, Color(0xFF43A047)],
                      begin: Alignment.topLeft,
                      end: Alignment.bottomRight,
                    ),
                    borderRadius: BorderRadius.circular(20),
                    boxShadow: [
                      BoxShadow(
                        color: AppTheme.primary.withOpacity(0.3),
                        blurRadius: 16,
                        offset: const Offset(0, 6),
                      ),
                    ],
                  ),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text('Total Borrowed',
                          style: GoogleFonts.poppins(
                              color: Colors.white70, fontSize: 13)),
                      const SizedBox(height: 4),
                      Text(
                        'UGX ${fmt.format(stats['totalBorrowed'])}',
                        style: GoogleFonts.poppins(
                          color: Colors.white,
                          fontSize: 28,
                          fontWeight: FontWeight.w700,
                        ),
                      ),
                      const SizedBox(height: 16),
                      Row(
                        children: [
                          _balanceChip(Icons.check_circle_outline,
                              'Paid: UGX ${fmt.format(stats['totalPaid'])}'),
                          const SizedBox(width: 12),
                          _balanceChip(Icons.pending_outlined,
                              'Active: ${stats['activeLoans']} loan(s)'),
                        ],
                      ),
                    ],
                  ),
                ),

                const SizedBox(height: 20),

                // Stats grid
                GridView.count(
                  crossAxisCount: 2,
                  shrinkWrap: true,
                  physics: const NeverScrollableScrollPhysics(),
                  crossAxisSpacing: 12,
                  mainAxisSpacing: 12,
                  childAspectRatio: 1.4,
                  children: [
                    StatCard(
                      title: 'Active Loans',
                      value: '${stats['activeLoans']}',
                      icon: Icons.account_balance_wallet_rounded,
                      color: AppTheme.success,
                      onTap: onStatus,
                    ),
                    StatCard(
                      title: 'Pending',
                      value: '${stats['pendingLoans']}',
                      icon: Icons.schedule_rounded,
                      color: AppTheme.warning,
                      onTap: onStatus,
                    ),
                    StatCard(
                      title: 'Total Paid',
                      value: 'UGX ${fmt.format(stats['totalPaid'])}',
                      icon: Icons.verified_rounded,
                      color: AppTheme.info,
                      onTap: onRepay,
                    ),
                    StatCard(
                      title: 'Apply Now',
                      value: '+',
                      icon: Icons.add_circle_rounded,
                      color: AppTheme.primary,
                      onTap: onApply,
                    ),
                  ],
                ),

                const SizedBox(height: 20),

                // Quick actions
                SectionHeader(title: 'Quick Actions'),
                const SizedBox(height: 12),
                Row(
                  children: [
                    _QuickAction(
                      icon: Icons.add_card_rounded,
                      label: 'Apply\nLoan',
                      color: AppTheme.primary,
                      onTap: onApply,
                    ),
                    const SizedBox(width: 10),
                    _QuickAction(
                      icon: Icons.list_alt_rounded,
                      label: 'Loan\nStatus',
                      color: AppTheme.info,
                      onTap: onStatus,
                    ),
                    const SizedBox(width: 10),
                    _QuickAction(
                      icon: Icons.payments_rounded,
                      label: 'Make\nPayment',
                      color: AppTheme.success,
                      onTap: onRepay,
                    ),
                    const SizedBox(width: 10),
                    _QuickAction(
                      icon: Icons.notifications_rounded,
                      label: 'Alerts',
                      color: AppTheme.warning,
                      onTap: onNotif,
