Options -MultiViews -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# 1) If anyone types a URL ending in .php, send them to the clean one (index.php -> index)
RewriteCond %{THE_REQUEST} \s/+[^?\s]*\.php[\s?] [NC]
RewriteRule ^(.+)\.php$ $1 [R=301,L,NE]

# 2) Real files (css, js, images) are served normally
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# 3) Everything else goes to the front controller
RewriteRule ^ index.php [L]
</IfModule>

# Block sensitive files
<FilesMatch "^\.(env|git)|\.(sql|log|md)$">
    Require all denied
</FilesMatch>
