# MarzPay API Credentials
# Get these from: https://wallet.wearemarz.com/dashboard/settings/api
# Format: Base64 encoded string of "API_KEY:API_SECRET"
MARZPAY_AUTH=your_base64_encoded_marzpay_credentials_here

# MarzPay API Base URL (usually don't need to change this)
MARZPAY_BASE=https://wallet.wearemarz.com/api/v1

# Groq API Key (for AI assistant features)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Proxy Authentication Key
# This key is used by your apps (Flutter/PHP) to authenticate with this proxy
PROXY_KEY=saccoplus_pro_2025_proxy_key

# Server Port
PORT=3000
